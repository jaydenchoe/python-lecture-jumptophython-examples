    "  # 3. 선택한 링크의 'href' 속성 값을 가져온다.\n",
    "  apply_link = all_links[1][\"href\"]\n",
    "  \n",
    "  print(f\"제목: {h2_element.text.strip()}\")\n",
    "  print(f\"지원 링크: {apply_link}\")\n",
    "  print(\"-\" * 20)"
