   "source": [
    "import requests\n",
    "from bs4 import BeautifulSoup\n",
    "\n",
    "URL = \"https://realpython.github.io/fake-jobs/\"\n",
    "page = requests.get(URL)\n",
    "\n",
    "soup = BeautifulSoup(page.content, \"html.parser\")\n",
    "results = soup.find(id=\"ResultsContainer\")\n",
    "\n",
    "# <h2> 태그이면서 텍스트에 'python'이 포함된 모든 요소를 찾기\n",
    "python_job_titles = results.find_all(\n",
    "    \"h2\", string=lambda text: \"python\" in text.lower()\n",
    ")\n",
    "\n",
    "print(f\"총 {len(python_job_titles)}개의 '파이썬' 관련 공고를 찾았습니다.\\n\")\n",
    "print(\"=\" * 30)\n",
    "\n",
    "# 찾은 <h2> 태그들을 순회하면서\n",
    "for h2_element in python_job_titles:\n",
    "  # 부모의 부모의 부모 요소(카드 전체)를 찾고\n",
    "  job_card = h2_element.parent.parent.parent\n",
    "  \n",
    "  # 카드 안에서 회사명, 위치, 지원 링크를 각각 찾기\n",
    "  company_element = job_card.find(\"h3\", class_=\"company\")\n",
    "  location_element = job_card.find(\"p\", class_=\"location\")\n",
    "  link_url = job_card.find_all(\"a\")[1][\"href\"]\n",
    "  \n",
    "  # 깔끔하게 출력하기\n",
    "  print(f\"🐍 {h2_element.text.strip()}\")\n",
    "  print(f\"🏢 {company_element.text.strip()}\")\n",
    "  print(f\"📍 {location_element.text.strip()}\")\n",
    "  print(f\"🔗 {link_url}\\n\")\n",
    "  print(\"-\" * 30)"
   ]
